{
  "name": "chunklens",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:egress": "node --experimental-websocket scripts/test-egress.cjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "lint": "tsc -b",
    "sync:csp": "node scripts/sync-csp.cjs",
    "check:bundle": "node scripts/check-bundle.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "js-tiktoken": "^1.0.17",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
